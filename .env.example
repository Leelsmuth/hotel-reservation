# Copy to .env.local and fill in. .env.local is git-ignored.
#
# No credentials? Run `npm run dev:mock` instead (or set
# NEXT_PUBLIC_USE_MOCKS=true below): none of the other variables are needed.

# --- Mock mode -------------------------------------------------------------
# true = run on dummy data: no Firebase, Stripe, PayPal or email needed.
NEXT_PUBLIC_USE_MOCKS=false
# Simulated API latency in mock mode, in ms (default 300; 0 disables it).
# MOCK_LATENCY_MS=300
# Mock mode sends the Stripe webhook this long after a mock payment, in ms
# (default 1500; negative turns it off).
# MOCK_WEBHOOK_DELAY_MS=1500

# --- Reservation holds ---------------------------------------------------------
# Unpaid reservations hold their rooms for this long (default 60), plus a
# short extension once the guest starts paying (default 15). Shorten both to
# test expiry, e.g. RESERVATION_HOLD_MINUTES=2.
# RESERVATION_HOLD_MINUTES=60
# PAYMENT_GRACE_MINUTES=15
# If set, GET /api/cron/release-holds needs "Authorization: Bearer <CRON_SECRET>"
# (Vercel Cron sends this). Schedule it every few minutes.
CRON_SECRET=

# --- Firebase (Auth + Firestore) --------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Stripe -------------------------------------------------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret of the webhook endpoint https://<site>/api/stripe/webhook
# (Stripe dashboard > Developers > Webhooks, event payment_intent.succeeded)
STRIPE_WEBHOOK_SECRET=

# --- PayPal -------------------------------------------------------------------
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- Email (Gmail via nodemailer) ---------------------------------------------
EMAIL_USER=
EMAIL_PASSWORD=
